# ---- Server ----
PORT=3001
# Vite dev server port (defaults to 5000; macOS AirPlay Receiver uses 5000)
# WEB_PORT=5173
NODE_ENV=development
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Encrypts chat messages stored in the database (AES-256-GCM). 32 bytes as hex.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it out of the database and back it up: if it's lost, stored messages can't be read.
MESSAGE_ENCRYPTION_KEY=

# ---- Database ----
# Local: docker compose (npm run db:up). On Replit, use the DATABASE_URL Replit provides.
DATABASE_URL=postgres://moim:moim@localhost:5433/moim
# Set to "true" for hosted Postgres that requires TLS (Replit/Neon etc.)
DATABASE_SSL=false

# Used only by docker-compose for the local DB
POSTGRES_USER=moim
POSTGRES_PASSWORD=moim
POSTGRES_DB=moim
POSTGRES_PORT=5433

# ---- First admin (created on first start if no admin exists) ----
ADMIN_NAME=Admin
ADMIN_PASSCODE=0000
# Default passcode given to new members until the admin changes it in Settings
DEFAULT_PASSCODE=1234

# ---- Firebase push notifications (optional; push is disabled if blank) ----
# Firebase console > Project settings > General > Your apps (Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Firebase console > Project settings > Cloud Messaging > Web Push certificates
FIREBASE_VAPID_KEY=
# Firebase console > Project settings > Service accounts > Generate new private key
# Paste the JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT=
